# ==============================================================================
# Neema Zihalirwa Portfolio — Environment Variables Template
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact Form & Email Notifications (Milestone 7)
# Note: Designed for Vercel deployment without custom domain requirements.
# Option A: Standard SMTP / Gmail App Password (Zero custom domain needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=lucianna.neema@gmail.com
SMTP_PASS=your_app_specific_password_here
CONTACT_EMAIL_RECIPIENT=lucianna.neema@gmail.com

# WhatsApp Integration (Milestone 7)
# Click-to-chat WhatsApp action (E.164 phone format, e.g. 243XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: Meta WhatsApp Business Cloud API (Advanced, pending approval)
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
